<?xml version="1.0"?>
<ruleset name="Memberkin">
	<description>WordPress Coding Standards for Memberkin.</description>
	<file>./memberkin.php</file>
	<file>./uninstall.php</file>
	<file>./src</file>
	<file>./templates</file>
	<arg name="extensions" value="php"/>
	<arg value="sp"/>
	<arg name="colors"/>
	<config name="minimum_wp_version" value="6.5"/>
	<config name="testVersion" value="8.1-"/>
	<rule ref="WordPress-Extra">
		<!-- PSR-4 class files: file names follow class names. -->
		<exclude name="WordPress.Files.FileName"/>
		<!-- Short array syntax is not used; long array() is kept, matching WP core style. -->
	</rule>
	<rule ref="WordPress-Docs"/>
	<!-- Exception messages are plain text and are escaped where they are displayed (Flash::render, REST JSON). -->
	<rule ref="WordPress.Security.EscapeOutput.ExceptionNotEscaped">
		<severity>0</severity>
	</rule>
	<rule ref="PHPCompatibilityWP"/>
	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array"><element value="memberkin"/></property>
		</properties>
	</rule>
	<!-- Templates run inside Templates::render()'s closure scope, so their variables are not globals. -->
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals.NonPrefixedVariableFound">
		<exclude-pattern>templates/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="memberkin"/>
				<element value="Memberkin"/>
			</property>
		</properties>
	</rule>
</ruleset>
